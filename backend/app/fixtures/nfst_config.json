{
  "scheme_code": "NFST",
  "version": 1,
  "form_schema": {
    "fields": [
      {
        "key": "applicant_name",
        "label": "Full Name",
        "type": "text",
        "required": true,
        "placeholder": "Full name as per official certificates",
        "help_text": "Must match name on Caste and Income certificates"
      },
      {
        "key": "applicant_email",
        "label": "Email Address",
        "type": "email",
        "required": true,
        "placeholder": "applicant@example.com",
        "help_text": "All official correspondence and status alerts will be sent here"
      },
      {
        "key": "applicant_phone",
        "label": "Mobile Phone Number",
        "type": "text",
        "required": true,
        "placeholder": "+91-9876543210",
        "help_text": "10-digit mobile number linked to official communications"
      },
      {
        "key": "age",
        "label": "Applicant Age (Years)",
        "type": "number",
        "required": true,
        "placeholder": "e.g. 26",
        "help_text": "Must be 36 years or below as of application date"
      },
      {
        "key": "annual_income",
        "label": "Annual Family Income (INR)",
        "type": "number",
        "required": true,
        "placeholder": "e.g. 480000",
        "help_text": "Must not exceed INR 6,00,000 as per latest revenue certificate"
      },
      {
        "key": "category",
        "label": "Social Category",
        "type": "select",
        "required": true,
        "options": ["ST"],
        "help_text": "Scheme is specifically for Scheduled Tribe candidates"
      },
      {
        "key": "qualification",
        "label": "Highest Qualifying Degree",
        "type": "select",
        "required": true,
        "options": ["Post-Graduate", "M.Phil", "Master of Science", "Master of Arts", "Master of Technology", "Other"],
        "help_text": "Minimum qualifying examination completed"
      },
      {
        "key": "university",
        "label": "Admitted University / Institute",
        "type": "text",
        "required": true,
        "placeholder": "e.g. Jawaharlal Nehru University, Delhi",
        "help_text": "UGC-recognized university where Ph.D/M.Phil is registered"
      },
      {
        "key": "percentage",
        "label": "Qualifying Examination Percentage",
        "type": "number",
        "required": true,
        "placeholder": "e.g. 74.5",
        "help_text": "Aggregate percentage scored in Master's degree"
      },
      {
        "key": "admission_confirmed",
        "label": "Admission Confirmed into M.Phil / Ph.D?",
        "type": "select",
        "required": true,
        "options": ["Yes", "No"],
        "help_text": "Bonafide admission confirmed letter must be submitted"
      }
    ]
  },
  "eligibility_rules": [
    {
      "field": "age",
      "condition": {
        "<=": [
          { "var": "age" },
          36
        ]
      },
      "failure_message": "Applicant age must be 36 years or below."
    },
    {
      "field": "annual_income",
      "condition": {
        "<=": [
          { "var": "annual_income" },
          600000
        ]
      },
      "failure_message": "Annual family income must not exceed INR 6,00,000."
    },
    {
      "field": "category",
      "condition": {
        "==": [
          { "var": "category" },
          "ST"
        ]
      },
      "failure_message": "Candidate must belong to Scheduled Tribe (ST) category."
    }
  ],
  "required_documents": [
    {
      "doc_type": "caste_certificate",
      "label": "Caste / Tribe Certificate",
      "required": true,
      "accepted_formats": ["pdf", "jpg", "png"],
      "issuing_authority": "District Magistrate / SDM",
      "ocr_fields": ["name", "father_name", "category", "certificate_number"]
    },
    {
      "doc_type": "income_certificate",
      "label": "Family Income Certificate",
      "required": true,
      "accepted_formats": ["pdf", "jpg"],
      "validity_days": 365,
      "issuing_authority": "Tehsildar / Revenue Officer",
      "ocr_fields": ["name", "annual_income", "issuing_date"]
    },
    {
      "doc_type": "marksheet",
      "label": "Post-Graduate Qualifying Marksheet",
      "required": true,
      "accepted_formats": ["pdf"],
      "ocr_fields": ["name", "percentage", "university", "year_of_passing"]
    },
    {
      "doc_type": "bonafide_certificate",
      "label": "University Bonafide Research Certificate",
      "required": true,
      "accepted_formats": ["pdf"],
      "ocr_fields": ["name", "enrollment_number", "institution"]
    }
  ],
  "merit_criteria": [
    {
      "name": "Academic Performance",
      "field": "percentage",
      "weight": 40,
      "max_score": 100,
      "description": "Post-graduate qualifying examination percentage"
    },
    {
      "name": "Research Proposal Quality",
      "field": "research_score",
      "weight": 30,
      "max_score": 100,
      "description": "Expert panel evaluation of research proposal"
    },
    {
      "name": "Interview Score",
      "field": "interview_score",
      "weight": 20,
      "max_score": 100,
      "description": "Selection committee interview rating"
    },
    {
      "name": "Publication Record",
      "field": "publication_score",
      "weight": 10,
      "max_score": 100,
      "description": "Prior publications and conference presentations"
    }
  ],
  "preference_rules": [
    {
      "name": "PVTG Community",
      "field": "is_pvtg",
      "condition": { "==": [{ "var": "is_pvtg" }, true] },
      "bonus_points": 5,
      "description": "Particularly Vulnerable Tribal Group (PVTG) preference"
    },
    {
      "name": "First-generation Scholar",
      "field": "first_generation",
      "condition": { "==": [{ "var": "first_generation" }, true] },
      "bonus_points": 3,
      "description": "First member of family to pursue higher education"
    }
  ],
  "workflow_states": [
    { "name": "submitted", "label": "Application Submitted", "is_terminal": false },
    { "name": "eligibility_check", "label": "Automated Eligibility Evaluation", "is_terminal": false },
    { "name": "document_scrutiny", "label": "Officer Document Scrutiny", "is_terminal": false },
    { "name": "deficient", "label": "Document Correction Required", "is_terminal": false },
    { "name": "selection", "label": "Selection Committee Scoring", "is_terminal": false },
    { "name": "approved", "label": "Fellowship Awarded", "is_terminal": false },
    { "name": "disbursed", "label": "Fellowship Disbursed", "is_terminal": true },
    { "name": "rejected", "label": "Application Rejected", "is_terminal": true }
  ],
  "workflow_transitions": [
    {
      "from_state": "submitted",
      "to_state": "eligibility_check",
      "trigger": "auto_evaluate",
      "allowed_roles": []
    },
    {
      "from_state": "eligibility_check",
      "to_state": "document_scrutiny",
      "trigger": "eligibility_passed",
      "allowed_roles": []
    },
    {
      "from_state": "eligibility_check",
      "to_state": "rejected",
      "trigger": "eligibility_failed",
      "allowed_roles": []
    },
    {
      "from_state": "document_scrutiny",
      "to_state": "selection",
      "trigger": "documents_verified",
      "allowed_roles": ["SCRUTINY_OFFICER", "SUPER_ADMIN"]
    },
    {
      "from_state": "document_scrutiny",
      "to_state": "deficient",
      "trigger": "documents_flagged_deficient",
      "allowed_roles": ["SCRUTINY_OFFICER", "SUPER_ADMIN"]
    },
    {
      "from_state": "deficient",
      "to_state": "document_scrutiny",
      "trigger": "resubmitted",
      "allowed_roles": []
    },
    {
      "from_state": "selection",
      "to_state": "approved",
      "trigger": "committee_approved",
      "allowed_roles": ["SELECTION_COMMITTEE", "SUPER_ADMIN"]
    },
    {
      "from_state": "selection",
      "to_state": "rejected",
      "trigger": "committee_rejected",
      "allowed_roles": ["SELECTION_COMMITTEE", "SUPER_ADMIN"]
    },
    {
      "from_state": "approved",
      "to_state": "disbursed",
      "trigger": "disbursed",
      "allowed_roles": ["SCHEME_ADMIN", "SUPER_ADMIN"]
    }
  ],
  "initial_state": "submitted",
  "sla_rules": [
    {
      "stage": "eligibility_check",
      "duration_hours": 4,
      "warning_hours": 2,
      "escalation_role": "SCHEME_ADMIN"
    },
    {
      "stage": "document_scrutiny",
      "duration_hours": 48,
      "warning_hours": 12,
      "escalation_role": "SUPER_ADMIN"
    },
    {
      "stage": "selection",
      "duration_hours": 72,
      "warning_hours": 24,
      "escalation_role": "SUPER_ADMIN"
    }
  ],
  "notification_rules": [
    {
      "event": "application_submitted",
      "channels": ["portal", "email"],
      "template": "Dear {applicant_name}, your application for NFST (ID: {application_id}) has been submitted successfully.",
      "recipient": "applicant"
    },
    {
      "event": "eligibility_passed",
      "channels": ["portal"],
      "template": "Your application has passed eligibility verification and is now under document scrutiny.",
      "recipient": "applicant"
    },
    {
      "event": "documents_flagged_deficient",
      "channels": ["portal", "email"],
      "template": "Action required: Your application has document deficiencies. Please resubmit the flagged documents.",
      "recipient": "applicant"
    },
    {
      "event": "committee_approved",
      "channels": ["portal", "email"],
      "template": "Congratulations! Your NFST fellowship application has been approved by the selection committee.",
      "recipient": "applicant"
    }
  ],
  "conflict_rules": [
    {
      "incompatible_schemes": ["NOS", "NFST"],
      "policy": "concurrent_prohibited",
      "matching_fields": ["applicant_name", "date_of_birth", "mobile", "applicant_email"]
    }
  ]
}
