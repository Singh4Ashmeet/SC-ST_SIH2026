{
  "scheme_code": "NOS",
  "version": 1,
  "form_schema": {
    "fields": [
      {
        "key": "applicant_name",
        "label": "Full Name",
        "type": "text",
        "required": true,
        "placeholder": "Full name as in Passport",
        "help_text": "Must match name on Passport and University Admission Offer"
      },
      {
        "key": "applicant_email",
        "label": "Email Address",
        "type": "email",
        "required": true,
        "placeholder": "applicant@example.com",
        "help_text": "Official communications for National Overseas Scholarship"
      },
      {
        "key": "applicant_phone",
        "label": "Mobile Phone Number",
        "type": "text",
        "required": true,
        "placeholder": "+91-9876543210",
        "help_text": "Active mobile phone number"
      },
      {
        "key": "age",
        "label": "Applicant Age (Years)",
        "type": "number",
        "required": true,
        "placeholder": "e.g. 28",
        "help_text": "Must be 35 years or below"
      },
      {
        "key": "annual_income",
        "label": "Annual Family Income (INR)",
        "type": "number",
        "required": true,
        "placeholder": "e.g. 550000",
        "help_text": "Total family annual income from all sources"
      },
      {
        "key": "category",
        "label": "Social Category",
        "type": "select",
        "required": true,
        "options": ["ST"],
        "help_text": "Scheduled Tribe category confirmation"
      },
      {
        "key": "university_abroad",
        "label": "Foreign Admitted University",
        "type": "text",
        "required": true,
        "placeholder": "e.g. University of Oxford / Imperial College London",
        "help_text": "QS World Ranked Top 500 foreign institution"
      },
      {
        "key": "course",
        "label": "Enrolled Course of Study",
        "type": "text",
        "required": true,
        "placeholder": "e.g. Master of Science in Data Engineering",
        "help_text": "Post Graduate / Ph.D program abroad"
      },
      {
        "key": "qualifying_exam_percent",
        "label": "Qualifying Degree Aggregate Percentage",
        "type": "number",
        "required": true,
        "placeholder": "e.g. 68.5",
        "help_text": "Minimum 60% aggregate marks required in qualifying degree"
      },
      {
        "key": "admission_confirmed",
        "label": "Unconditional Admission Confirmed?",
        "type": "boolean",
        "required": true,
        "help_text": "Select if you possess an unconditional foreign university admission letter"
      }
    ]
  },
  "eligibility_rules": [
    {
      "field": "qualifying_exam_percent",
      "condition": {
        ">=": [
          { "var": "qualifying_exam_percent" },
          60
        ]
      },
      "failure_message": "Minimum 60% aggregate marks required in qualifying degree."
    },
    {
      "field": "admission_confirmed",
      "condition": {
        "==": [
          { "var": "admission_confirmed" },
          true
        ]
      },
      "failure_message": "Unconditional foreign university admission offer required."
    },
    {
      "field": "age",
      "condition": {
        "<=": [
          { "var": "age" },
          35
        ]
      },
      "failure_message": "Applicant age must not exceed 35 years."
    }
  ],
  "required_documents": [
    {
      "doc_type": "passport",
      "label": "Valid Indian Passport",
      "required": true,
      "accepted_formats": ["pdf"]
    },
    {
      "doc_type": "admission_letter",
      "label": "Unconditional Foreign University Admission Letter",
      "required": true,
      "accepted_formats": ["pdf"]
    },
    {
      "doc_type": "degree_transcript",
      "label": "Graduation Degree & Official Transcripts",
      "required": true,
      "accepted_formats": ["pdf"]
    },
    {
      "doc_type": "ielts_toefl_scorecard",
      "label": "Language Proficiency Scorecard",
      "required": false,
      "accepted_formats": ["pdf", "jpg", "png"]
    }
  ],
  "workflow_states": [
    { "name": "submitted", "label": "Application Submitted", "is_terminal": false },
    { "name": "eligibility_check", "label": "Automated Eligibility Check", "is_terminal": false },
    { "name": "document_scrutiny", "label": "Embassy & Officer Verification", "is_terminal": false },
    { "name": "selection", "label": "National Selection Committee", "is_terminal": false },
    { "name": "approved", "label": "Provisional Award Granted", "is_terminal": false },
    { "name": "visa_issued", "label": "Visa & Airfare Finalized", "is_terminal": true },
    { "name": "rejected", "label": "Disqualified / Rejected", "is_terminal": true }
  ],
  "workflow_transitions": [
    {
      "from_state": "submitted",
      "to_state": "eligibility_check",
      "trigger": "start_automated_check",
      "allowed_roles": []
    },
    {
      "from_state": "eligibility_check",
      "to_state": "document_scrutiny",
      "trigger": "eligibility_passed",
      "allowed_roles": []
    },
    {
      "from_state": "eligibility_check",
      "to_state": "rejected",
      "trigger": "eligibility_failed",
      "allowed_roles": []
    },
    {
      "from_state": "document_scrutiny",
      "to_state": "selection",
      "trigger": "documents_verified",
      "allowed_roles": ["SCRUTINY_OFFICER", "SUPER_ADMIN"]
    },
    {
      "from_state": "selection",
      "to_state": "approved",
      "trigger": "committee_approved",
      "allowed_roles": ["SELECTION_COMMITTEE", "SUPER_ADMIN"]
    },
    {
      "from_state": "selection",
      "to_state": "rejected",
      "trigger": "committee_rejected",
      "allowed_roles": ["SELECTION_COMMITTEE", "SUPER_ADMIN"]
    },
    {
      "from_state": "approved",
      "to_state": "visa_issued",
      "trigger": "grant_issued",
      "allowed_roles": ["SCHEME_ADMIN", "SUPER_ADMIN"]
    }
  ],
  "initial_state": "submitted"
}
